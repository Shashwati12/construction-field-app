generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String          @id @default(uuid())
  name        String
  phone       String          @unique
  role        Role
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  password    String
  attendances Attendance[]
  auditLogs   AuditLog[]
  dprs        DPR[]
  projects    ProjectMember[]
}

model Project {
  id               String            @id @default(uuid())
  name             String
  location         String
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendances      Attendance[]
  dprs             DPR[]
  invoices         Invoice[]
  materialRequests MaterialRequest[]
  members          ProjectMember[]
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  projectRole Role
  joinedAt    DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Attendance {
  id          String   @id @default(uuid())
  userId      String
  projectId   String
  date        DateTime
  checkInTime DateTime
  gpsLat      Float
  gpsLong     Float
  status      String   @default("PRESENT")
  markedBy    String
  project     Project  @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, projectId, date])
}

model DPR {
  id          String     @id @default(uuid())
  projectId   String
  userId      String
  date        DateTime
  description String
  createdBy   String
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  photos      DPRPhoto[]
}

model DPRPhoto {
  id         String   @id @default(uuid())
  dprId      String
  imageUrl   String
  uploadedAt DateTime @default(now())
  dpr        DPR      @relation(fields: [dprId], references: [id])
}

model Material {
  id           String                @id @default(uuid())
  name         String
  unit         String
  requestItems MaterialRequestItem[]
}

model MaterialRequest {
  id          String                @id @default(uuid())
  projectId   String
  requestedBy String
  status      String                @default("PENDING")
  createdAt   DateTime              @default(now())
  approvals   MaterialApproval[]
  project     Project               @relation(fields: [projectId], references: [id])
  items       MaterialRequestItem[]
}

model MaterialRequestItem {
  id         String          @id @default(uuid())
  requestId  String
  materialId String
  quantity   Float
  material   Material        @relation(fields: [materialId], references: [id])
  request    MaterialRequest @relation(fields: [requestId], references: [id])
}

model MaterialApproval {
  id         String          @id @default(uuid())
  requestId  String
  approvedBy String
  decision   String
  remarks    String?
  decidedAt  DateTime        @default(now())
  request    MaterialRequest @relation(fields: [requestId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  projectId     String
  invoiceNumber String
  gstNumber     String
  totalAmount   Float
  status        String
  issuedAt      DateTime      @default(now())
  project       Project       @relation(fields: [projectId], references: [id])
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Float
  rate        Float
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

enum Role {
  OWNER
  MANAGER
  SITE_ENGINEER
  SUPERVISOR
  WORKER
  ACCOUNTANT
}
